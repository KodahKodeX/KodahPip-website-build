---
import '../styles/global.css';
import { site } from '../site.config';

interface Props {
  title?: string;
  description?: string;
}
const { title, description = site.description } = Astro.props;
const fullTitle = title ? `${title} — ${site.name}` : site.title;
const path = Astro.url.pathname;
const nav = [
  { href: '/speaking/', label: 'Speaking' },
  { href: '/#work', label: 'Work' },
  { href: '/writing/', label: 'Writing' },
  { href: '/about/', label: 'About' },
];
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#15100c" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(path, Astro.site)} />
    <meta property="og:image" content={new URL('/og.jpg', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <header class="top">
      <div class="wrap bar">
        <a href="/" class="mark" aria-label="Kodah Pipitone, home">
          Kodah <span>Pipitone</span>
        </a>
        <input type="checkbox" id="navtoggle" class="sr-only" />
        <label for="navtoggle" class="burger" aria-label="Menu"><span></span><span></span></label>
        <nav aria-label="Main">
          {nav.map((n) => (
            <a href={n.href} aria-current={path.startsWith(n.href) && n.href !== '/#work' ? 'page' : undefined}>
              {n.label}
            </a>
          ))}
          <a href="/#contact" class="cta">Book Kodah</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap">
        <p class="sig">Tune <em class="gold">everything.</em></p>
        <div class="cols">
          <div>
            <p class="eyebrow">Contact</p>
            <a class="link" href={`mailto:${site.email}`}>{site.email}</a>
          </div>
          <div>
            <p class="eyebrow">Elsewhere</p>
            <a href={site.social.linkedin} rel="noopener">LinkedIn</a>
            <a href={site.social.instagram} rel="noopener">Instagram</a>
            <a href={site.activ8Url} rel="noopener">ACTIV8</a>
          </div>
          <div>
            <p class="eyebrow">Site</p>
            {nav.map((n) => <a href={n.href}>{n.label}</a>)}
          </div>
        </div>
        <p class="small">© {year} Kodah Pipitone · Los Angeles</p>
      </div>
    </footer>

    <script>
      const io = new IntersectionObserver(
        (entries) =>
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          }),
        { threshold: 0.12 }
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
      // close the mobile menu after choosing a link
      document.querySelectorAll('header nav a').forEach((a) =>
        a.addEventListener('click', () => {
          const t = document.getElementById('navtoggle') as HTMLInputElement | null;
          if (t) t.checked = false;
        })
      );
    </script>
  </body>
</html>

<style>
  .top {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    background: linear-gradient(to bottom, rgba(21, 16, 12, 0.92), rgba(21, 16, 12, 0));
    backdrop-filter: blur(2px);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 76px;
  }
  .mark {
    font-family: var(--serif);
    font-size: 24px;
    text-decoration: none;
    letter-spacing: 0.02em;
  }
  .mark span {
    color: var(--sand);
  }
  nav {
    display: flex;
    align-items: center;
    gap: 34px;
  }
  nav a {
    text-decoration: none;
    font-size: 12px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--sand);
    transition: color 0.2s;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--bone);
  }
  nav a.cta {
    color: var(--bone);
    border: 1px solid var(--gold);
    padding: 10px 16px;
  }
  nav a.cta:hover {
    background: var(--gold);
    color: var(--obsidian);
  }
  .burger {
    display: none;
  }

  @media (max-width: 820px) {
    .burger {
      display: flex;
      flex-direction: column;
      gap: 7px;
      cursor: pointer;
      padding: 10px 0 10px 10px;
      z-index: 2;
    }
    .burger span {
      width: 26px;
      height: 1px;
      background: var(--bone);
      transition: transform 0.3s;
    }
    nav {
      position: fixed;
      inset: 0;
      background: var(--obsidian);
      flex-direction: column;
      justify-content: center;
      gap: 30px;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s;
    }
    nav a {
      font-size: 15px;
    }
    #navtoggle:checked ~ nav {
      opacity: 1;
      pointer-events: auto;
    }
    #navtoggle:checked ~ .burger span:first-child {
      transform: translateY(4px) rotate(45deg);
    }
    #navtoggle:checked ~ .burger span:last-child {
      transform: translateY(-4px) rotate(-45deg);
    }
  }

  .foot {
    position: relative;
    overflow: hidden;
    border-top: 1px solid var(--line);
    padding: 96px 0 40px;
    background: var(--graphite);
  }
  /* carved contour lines, like the parametric wood in the references */
  .foot::before {
    content: '';
    position: absolute;
    inset: 0;
    background: url('/img/contours.svg') center / cover no-repeat;
    opacity: 0.22;
    pointer-events: none;
  }
  .foot > .wrap {
    position: relative;
  }
  .sig {
    font-family: var(--serif);
    font-size: clamp(44px, 7vw, 88px);
    line-height: 1;
    margin: 0 0 64px;
  }
  .cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    margin-bottom: 64px;
  }
  .cols > div {
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: flex-start;
  }
  .cols a:not(.link) {
    color: var(--sand);
    text-decoration: none;
  }
  .cols a:not(.link):hover {
    color: var(--bone);
  }
  .small {
    font-size: 13px;
    color: var(--sand-dim);
    margin: 0;
  }
  @media (max-width: 700px) {
    .cols {
      grid-template-columns: 1fr;
    }
  }
</style>
