---
import { site } from '../site.config';
const action = site.formspreeId ? `https://formspree.io/f/${site.formspreeId}` : '';
---

<section id="contact" class="contact">
  <div class="wrap grid">
    <div class="reveal">
      <p class="eyebrow">Begin</p>
      <h2>What are you <em class="gold">bringing into tune?</em></h2>
      <p class="lede">
        A keynote, a gathering of leaders, a launch that needs to be felt. Tell me what you're planning and when. I reply within two
        business days.
      </p>
      <hr class="rule" />
      <p class="direct">
        Or write directly: <a class="link" href={`mailto:${site.email}`}>{site.email}</a>
      </p>
      {site.calendly && (
        <a class="btn quiet" href={site.calendly} rel="noopener">Book a 20-minute call</a>
      )}
    </div>

    <form class="reveal" method="POST" action={action || undefined} data-email={site.email} data-live={action ? 'true' : 'false'}>
      <label>
        <span>Name</span>
        <input name="name" required autocomplete="name" />
      </label>
      <label>
        <span>Email</span>
        <input name="email" type="email" required autocomplete="email" />
      </label>
      <label>
        <span>Organization</span>
        <input name="organization" autocomplete="organization" />
      </label>
      <label>
        <span>What are you planning?</span>
        <select name="type" required>
          <option value="" disabled selected>Choose one</option>
          <option>Keynote or opening address</option>
          <option>Leadership gathering or offsite</option>
          <option>Launch, activation or brand experience</option>
          <option>Something else</option>
        </select>
      </label>
      <label>
        <span>When</span>
        <input name="timing" placeholder="Date, season, or 'exploring'" />
      </label>
      <label class="full">
        <span>Tell me more</span>
        <textarea name="message" rows="4"></textarea>
      </label>
      <button class="btn" type="submit">Send</button>
      <p class="note" aria-live="polite"></p>
    </form>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(48px, 7vw, 120px);
    align-items: start;
  }
  .direct {
    color: var(--sand);
  }
  form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px 24px;
  }
  label {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  label.full,
  label:has(select),
  label:has(textarea) {
    grid-column: 1 / -1;
  }
  label span {
    font-size: 11px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--sand);
  }
  input,
  select,
  textarea {
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--line);
    color: var(--bone);
    font: inherit;
    padding: 10px 0;
    border-radius: 0;
    transition: border-color 0.2s;
  }
  select option {
    background: var(--graphite);
  }
  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-color: var(--gold);
  }
  textarea {
    resize: vertical;
  }
  button {
    justify-self: start;
    background: transparent;
    cursor: pointer;
    font-family: inherit;
  }
  .note {
    grid-column: 1 / -1;
    color: var(--sand);
    margin: 0;
    min-height: 1em;
  }
  @media (max-width: 820px) {
    .grid,
    form {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLFormElement>('#contact form').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const note = form.querySelector('.note') as HTMLElement;
      const data = new FormData(form);
      if (form.dataset.live === 'true') {
        note.textContent = 'Sending…';
        try {
          const res = await fetch(form.action, {
            method: 'POST',
            body: data,
            headers: { Accept: 'application/json' },
          });
          if (!res.ok) throw new Error();
          form.reset();
          note.textContent = 'Received. I will be in touch within two business days.';
        } catch {
          note.textContent = `Something went wrong. Please email ${form.dataset.email} directly.`;
        }
        return;
      }
      // No form service connected yet: open a pre-filled email instead.
      const body = [...data.entries()].map(([k, v]) => `${k}: ${v}`).join('\n');
      const subject = `Inquiry: ${data.get('type') || 'kodahpip.com'}`;
      window.location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    });
  });
</script>
