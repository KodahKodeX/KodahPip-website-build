---
import Base from '../layouts/Base.astro';
import WoodWall from '../components/WoodWall.astro';
import ScrollStage from '../components/ScrollStage.astro';
import Scramble from '../components/Scramble.astro';
import Contact from '../components/Contact.astro';
import { site } from '../site.config';

const essays = Object.values(import.meta.glob('./writing/*.md', { eager: true }) as Record<string, any>)
  .map((m) => ({ ...m.frontmatter, url: m.url }))
  .filter((e) => !e.unlisted)
  .sort((a, b) => +new Date(b.date) - +new Date(a.date))
  .slice(0, 3);
---

<Base>
  <!-- HERO -->
  <div class="hero" data-hero>
    <WoodWall spine="var(--hero-spine)" shade={0.5} flow={0.18} />
    <div class="hero-shade"></div>
    <figure class="frame" data-depth="-8">
      <picture>
        <source media="(max-width: 760px)" srcset="/img/kodah-hero-photo-sm.webp" />
        <img src="/img/kodah-hero-photo.webp" alt="Kodah Pipitone in a grey blazer at a table in front of a chevron wood wall" width="1024" height="1390" fetchpriority="high" />
      </picture>
    </figure>
    <div class="wrap hero-inner" data-depth="5">
      <p class="eyebrow">Coach · Strategist · Speaker</p>
      <h1><Scramble text="Tune" delay={400} /><br /><em class="gold"><Scramble text="Everything." delay={800} /></em></h1>
      <div class="lede manifesto">
        <p class="listen">:::LISTEN:::</p>
        <p class="strong">We can hear the <em class="gold">FUTURE</em> approaching.</p>
        <p>
          I help <strong>leaders, teams,</strong> and <strong>cities</strong> <em class="gold">TUNE</em> their contributions
          to our <strong>Optimal Future.</strong>
        </p>
      </div>
      <div class="actions">
        <a class="btn" href="#contact">Book Kodah</a>
        <a class="btn quiet" href="#thesis">The thesis</a>
      </div>
    </div>
    <p class="scroll-cue" aria-hidden="true">Scroll</p>
  </div>

  <!-- THESIS: words come and go over the wall as you scroll -->
  <ScrollStage
    id="thesis"
    eyebrow="The Thesis"
    lines={[
      { text: 'Everything is', accent: 'an instrument.', sub: 'A being. A team. A family. A company. A city. Each can drift out of tune. Each can be brought back.' },
      { text: 'Tune', accent: 'the self.', sub: 'Coherence starts in the being. Lose contact with it, and every signal you send and receive is distorted.' },
      { text: 'Tune', accent: 'relationships.', sub: 'Families and teams are ensembles. Each voice stays distinct. The goal is resonance, not sameness.' },
      { text: 'Tune', accent: 'contribution.', sub: 'In tune, you notice the rooms, the work, and the places where you are the gift.', bg: '/img/future-coast.webp', bgPos: '42% 50%' },
      { text: 'Tune', accent: 'everything.', bg: '/img/future-city.webp', bgPos: '24% 60%' },
    ]}
  />

  <section class="origin-section">
    <div class="wrap">
      <div class="origin reveal">
        <p class="eyebrow">Why This Work</p>
        <p>
          I learned this founding and leading ventures—HostHome, Suyana Technologies, Permanence Capital, Urth Capital, CampUS Holdings Group, and now KyberKapital and the Resilience Fund—building each revealed keys to the journey. I kept meeting people in the wrong rooms: the wrong community, the wrong work, the wrong home. I knew the feeling. When I lost coherence with my own body, the signals that sort life scrambled.
        </p>
        <p>Tuning is how I found my way back. It is also how I help leaders, teams, and cultures do the same.</p>
      </div>
    </div>
  </section>

  <!-- TEAMS SERVED -->
  <section class="served">
    <div class="wrap served-grid">
      <div class="reveal">
        <p class="eyebrow">Teams I Have Served</p>
        <h2>A decade in <em class="gold">the room.</em></h2>
        <p class="served-note">
          The title changed with every engagement. What I brought did not: my being, and the gifts that come with it.
        </p>
      </div>
      <ul class="served-list reveal" aria-label="Past clients and collaborators">
        {site.served.map((name) => <li>{name}</li>)}
      </ul>
    </div>
  </section>

  <div class="inlay"></div>

  <!-- DOORS -->
  <section id="work" class="doors-section">
    <div class="wrap">
      <div class="head reveal">
        <p class="eyebrow">The Work</p>
        <h2>I read people <em class="gold">and markets.</em></h2>
        <p class="lede">
          The same perception runs through all of it: sensing what a person, a team, or a market is ready for, and tuning the path to
          get there. I work only with ventures that add signal, not noise.
        </p>
      </div>
      <div class="doors">
        <a class="door reveal featured" href={site.calendly || '#contact'} rel="noopener">
          <p class="eyebrow">01 · Coaching</p>
          <h3>Personal leadership coaching</h3>
          <p>
            For founders and leaders carrying something bigger than themselves. We tune the being first: body, attention,
            relationships. The decisions get clearer from there.
          </p>
          <span class="go">Book a discovery call <i>→</i></span>
        </a>
        <a class="door reveal" href="#contact">
          <p class="eyebrow">02 · Strategy</p>
          <h3>Market insight for innovators</h3>
          <p>
            For founders bringing new technology to market. I read cultural sentiment, consumer behavior, supply chains and
            regulation to show where an innovation stands, and whether the market is ready for it. Fund readiness and strategic
            introductions where they fit.
          </p>
          <span class="go">Start a conversation <i>→</i></span>
        </a>
        <a class="door reveal" href="/speaking/">
          <p class="eyebrow">03 · Speaking and Convenings</p>
          <h3>Keynotes and gatherings</h3>
          <p>
            Opening addresses, keynotes and leadership gatherings on technology, the self and coherence. ACTIV8 and SJP produce the
            experience around the talk.
          </p>
          <p class="offer"><strong>Start with Ignition:</strong> a half-day leadership experience, designed and opened by Kodah.</p>
          <span class="go">Speaking topics <i>→</i></span>
        </a>
      </div>
    </div>
  </section>

  <!-- SIGNATURE TALK -->
  <section class="talk" data-talk>
    <div class="talk-bg" aria-hidden="true">
      <img src="/img/tech-you-can-feel.webp" alt="" loading="lazy" decoding="async" />
    </div>
    <div class="wrap talk-copy">
      <div class="reveal">
        <p class="eyebrow">Signature Keynote</p>
        <h2>Technology<br />you can <em class="gold">feel.</em></h2>
      </div>
      <div class="reveal">
        <p class="big">
          Intelligence is moving beyond the screen. It is entering our clothes, our homes, our vehicles, and our bodies.
        </p>
        <p>
          I have lived that shift from the inside. Frontier medicine rewrote my body and my sense of self, and I came back with a
          clear view of what innovation does to people. This talk gives leaders a way to build technology people can feel, and
          live with.
        </p>
        <ol class="takeaways">
          <li>Where computing goes after the screen</li>
          <li>What frontier technology does to identity, and the ethical lines that matter</li>
          <li>How to design products, places, and experiences that bring people into coherence</li>
        </ol>
        <a class="link" href="/speaking/">All topics and formats</a>
      </div>
    </div>
  </section>

  <!-- PROOF -->
  <section class="proof">
    <div class="wrap">
      <div class="head reveal">
        <p class="eyebrow">Built on Real Production</p>
        <h2>Ideas made <em class="gold">inhabitable.</em></h2>
        <p class="lede">
          I am a partner in <a class="link" href={site.activ8Url} rel="noopener">ACTIV8</a>, a creative experience agency powered by
          SJP: twelve years of live production across Los Angeles and Las Vegas.
        </p>
        <div class="services">
          <figure class="ubu">
            <img src="/img/camp-ubu.webp" alt="Camp UBU's art car on the playa at Burning Man, crowded with campers, with a Trust the Process sign" width="1199" height="1100" loading="lazy" />
            <figcaption>Camp UBU, Burning Man. The art car, with artwork by Olivia Steele.</figcaption>
          </figure>
          <div>
            <p class="eyebrow">Through ACTIV8</p>
            <h3>Burning Man camp design and production</h3>
            <p>
              Full AV production at the core: sound systems, lighting, power and stages. Plus the build around them, from kitchens to
              common spaces, delivered on the playa.
            </p>
          </div>
          <div>
            <p class="eyebrow">Through ACTIV8</p>
            <h3>Immersive brand and product launches</h3>
            <p>Live experiences wrapped in digital marketing and UGC content pipelines, so the moment keeps working after the doors close.</p>
          </div>
        </div>
      </div>
      <ul class="credits reveal">
        <li><span>Camp UBU, Burning Man</span><em>65-person camp with full commercial power, kitchen and common-area infrastructure</em></li>
        <li><span>Interblock</span><em>Showroom and G2E experience</em></li>
        <li><span>IPME</span><em>Outdoor video wall booth</em></li>
        <li><span>Google Ads at CES</span><em>Production, through NVE</em></li>
        <li class="dev"><span>Pop Up Book</span><em>Immersive theatrical installation <b class="tag">In development</b></em></li>
        <li class="dev"><span>“Oh, the Places You’ll Go!”</span><em>Touring walkthrough experience <b class="tag">In development</b></em></li>
      </ul>
      <p class="fine reveal">Selected work by the ACTIV8 and SJP teams and their production partners.</p>
    </div>
  </section>

  <!-- STATEMENT -->
  <div class="inlay"></div>
  <section class="statement">
    <WoodWall spine="50%" shade={0.62} flow={0.3} />
    <div class="wrap">
      <p class="reveal">The challenge is not strategy.<br />The challenge is <em class="gold">coherence.</em></p>
    </div>
  </section>

  <!-- WRITING -->
  {essays.length > 0 && (
    <section class="writing">
      <div class="wrap">
        <div class="head reveal row">
          <div>
            <p class="eyebrow">Writing</p>
            <h2>Notes from the frontier</h2>
          </div>
          {site.newsletterUrl && <a class="btn quiet" href={site.newsletterUrl} rel="noopener">Subscribe</a>}
        </div>
        <div class="essays">
          {essays.map((e) => (
            <a class="essay reveal" href={e.url}>
              <p class="eyebrow">{new Date(e.date).toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' })}</p>
              <h3>{e.title}</h3>
              <p>{e.summary}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <Contact />
</Base>

<style>
  .hero {
    --hero-spine: 70%;
    position: relative;
    min-height: max(100svh, 760px);
    padding: 120px 0 88px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
  }
  /* darken behind the words, and let the bottom settle into the page */
  .hero-shade {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(to right, rgba(18, 12, 8, 0.9) 0%, rgba(18, 12, 8, 0.7) 38%, rgba(18, 12, 8, 0.2) 62%, rgba(18, 12, 8, 0.1) 100%),
      radial-gradient(ellipse 40% 55% at var(--hero-spine) 45%, transparent 0%, rgba(18, 12, 8, 0.25) 100%);
  }
  /* the portrait, hung on the wall like a framed piece */
  .frame {
    position: absolute;
    z-index: 2;
    margin: 0;
    top: 104px;
    bottom: 64px;
    right: max(var(--gutter), calc((100vw - var(--max)) / 2 + 8px));
    aspect-ratio: 1024 / 1390;
    border: 1px solid rgba(207, 155, 92, 0.5);
    padding: 8px;
    background: rgba(18, 12, 8, 0.55);
    box-shadow: 0 40px 80px rgba(8, 5, 3, 0.7), 0 0 0 1px rgba(0, 0, 0, 0.4) inset;
    will-change: transform;
  }
  .frame picture,
  .frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .frame::after {
    content: '';
    position: absolute;
    left: -24px;
    right: -24px;
    bottom: -22px;
    height: 10px;
    background: url('/img/chevron-sm.webp') center / auto 324px repeat;
    box-shadow: 0 6px 18px rgba(8, 5, 3, 0.6);
  }
  .hero-inner {
    position: relative;
    z-index: 4;
    will-change: transform;
  }
  .hero h1 {
    margin-bottom: 28px;
    font-size: clamp(64px, 8.6vw, 128px);
    text-shadow: 0 2px 40px rgba(18, 12, 8, 0.9);
  }
  .hero .lede {
    color: var(--bone);
    opacity: 0.86;
    text-shadow: 0 1px 20px rgba(18, 12, 8, 0.95);
  }
  .manifesto {
    max-width: min(560px, 100%);
    font-size: clamp(17px, 1.4vw, 20px);
  }
  .manifesto p {
    margin: 0 0 16px;
  }
  .manifesto p:last-child {
    margin-bottom: 0;
  }
  .manifesto .listen {
    font-size: 12px;
    letter-spacing: 0.32em;
    color: var(--gold);
    margin-bottom: 12px;
  }
  .manifesto .strong {
    color: var(--bone);
    font-weight: 500;
  }
  .manifesto strong {
    color: var(--bone);
    font-weight: 600;
  }
  .actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 40px;
  }
  .actions .btn {
    background: rgba(18, 12, 8, 0.6);
    backdrop-filter: blur(4px);
  }
  .scroll-cue {
    position: absolute;
    z-index: 5;
    bottom: 26px;
    left: max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter)));
    margin: 0;
    font-size: 11px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--sand);
  }
  .scroll-cue::after {
    content: '';
    display: block;
    width: 1px;
    height: 26px;
    margin: 10px auto 0;
    background: linear-gradient(var(--gold), transparent);
    animation: cue 2.2s ease-in-out infinite;
  }
  @keyframes cue {
    0%, 100% { transform: scaleY(0.4); transform-origin: top; opacity: 0.4; }
    50% { transform: scaleY(1); transform-origin: top; opacity: 1; }
  }
  @media (max-width: 760px) {
    .hero {
      --hero-spine: 50%;
      height: auto;
      min-height: 0;
      display: block;
      padding: 76px 0 72px;
    }
    .hero-shade {
      background: linear-gradient(to bottom, rgba(18, 12, 8, 0.35) 0%, rgba(18, 12, 8, 0.6) 45%, rgba(18, 12, 8, 0.9) 70%, var(--obsidian) 100%);
    }
    .frame {
      position: relative;
      top: auto;
      bottom: auto;
      right: auto;
      margin: 0 var(--gutter) 48px;
      height: 52svh;
      aspect-ratio: auto;
      padding: 6px;
    }
    .frame img {
      object-position: 50% 12%;
    }
    .manifesto br {
      display: none;
    }
    .frame::after {
      left: -8px;
      right: -8px;
      bottom: -16px;
      height: 8px;
    }
    .hero-inner {
      margin-top: 0;
    }
    .hero h1 {
      font-size: clamp(56px, 17vw, 84px);
      margin-bottom: 18px;
    }
    .actions {
      margin-top: 26px;
    }
    .scroll-cue {
      display: none;
    }
  }

  .origin-section {
    border-top: 0;
  }
  .head {
    margin-bottom: clamp(48px, 7vw, 88px);
  }
  .head .lede {
    margin-top: 28px;
  }
  .head.row {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
    flex-wrap: wrap;
  }

  .panels {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--line);
  }
  .panels article {
    padding: 40px 36px 40px 0;
    border-right: 1px solid var(--line);
  }
  .panels article + article {
    padding-left: 36px;
  }
  .panels article:last-child {
    border-right: 0;
  }
  .num {
    font-family: var(--serif);
    color: var(--gold);
    font-size: 22px;
  }
  .panels h3 {
    margin: 18px 0 16px;
  }
  .panels p {
    color: var(--sand);
    margin: 0;
  }
  .origin {
    margin-top: clamp(64px, 8vw, 110px);
    max-width: 760px;
    margin-left: auto;
    font-family: var(--serif);
    font-size: clamp(22px, 2.3vw, 28px);
    line-height: 1.45;
  }
  .origin p {
    margin: 0 0 20px;
  }
  .origin p + p {
    color: var(--sand);
  }

  .served-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: clamp(40px, 6vw, 96px);
    align-items: start;
  }
  .served-note {
    color: var(--sand);
    margin-top: 24px;
    max-width: 420px;
  }
  .served-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 32px;
    border-top: 1px solid var(--line);
  }
  .served-list li {
    font-family: var(--serif);
    font-size: clamp(22px, 2.2vw, 28px);
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
  }

  .doors {
    display: grid;
    grid-template-columns: 1.25fr 1fr 1fr;
    gap: 20px;
  }
  .door {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    padding: 40px 32px;
    background: var(--graphite);
    border: 1px solid var(--line);
    text-decoration: none;
    transition: border-color 0.3s, transform 0.3s;
  }
  a.door:hover {
    border-color: var(--gold);
  }
  .door::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 6px;
    background: url('/img/chevron-sm.webp') center / auto 324px repeat;
    opacity: 0.85;
  }
  .door h3 {
    margin-bottom: 18px;
  }
  .door p:not(.eyebrow) {
    color: var(--sand);
    margin: 0 0 16px;
  }
  .door .offer {
    color: var(--bone) !important;
    border-top: 1px solid var(--line);
    padding-top: 16px;
  }
  .door.featured {
    background: var(--graphite-2);
  }
  .go {
    margin-top: auto;
    padding-top: 12px;
    font-size: 12px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }
  .go i {
    font-style: normal;
    color: var(--gold);
    display: inline-block;
    transition: transform 0.3s;
  }
  a.door:hover .go i {
    transform: translateX(6px);
  }
  .quiet-door {
    background: transparent;
  }

  .talk {
    position: relative;
    overflow: hidden;
  }
  .talk-bg {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 0;
  }
  .talk-bg img {
    display: block;
    width: 100%;
    height: auto;
    min-height: 560px;
    object-fit: cover;
    object-position: 68% 30%;
    opacity: 0;
    transform: scale(1.08);
    will-change: opacity, transform;
  }
  .talk-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to right, rgba(18, 12, 8, 0.95) 0%, rgba(18, 12, 8, 0.86) 36%, rgba(18, 12, 8, 0.3) 60%, rgba(18, 12, 8, 0.08) 100%),
      linear-gradient(to bottom, var(--obsidian) 0%, transparent 18%, transparent 62%, var(--obsidian) 100%);
  }
  .talk-copy {
    position: relative;
    z-index: 1;
  }
  .talk-copy > div {
    max-width: 540px;
  }
  .talk-copy h2 {
    margin-bottom: 40px;
  }
  .talk .big {
    font-family: var(--serif);
    font-size: clamp(26px, 2.8vw, 34px);
    line-height: 1.3;
    margin-top: 0;
  }
  .talk p {
    color: var(--sand);
  }
  .talk .big {
    color: var(--bone);
  }
  .takeaways {
    list-style: none;
    counter-reset: t;
    padding: 0;
    margin: 36px 0 40px;
    border-top: 1px solid var(--line);
  }
  .takeaways li {
    counter-increment: t;
    padding: 18px 0 18px 48px;
    border-bottom: 1px solid var(--line);
    position: relative;
  }
  .takeaways li::before {
    content: '0' counter(t);
    position: absolute;
    left: 0;
    color: var(--gold);
    font-size: 13px;
    letter-spacing: 0.1em;
    top: 21px;
  }

  .services {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 20px;
    margin-top: 40px;
  }
  .ubu {
    grid-row: span 2;
    margin: 0;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    background: var(--graphite);
    padding: 8px;
  }
  .ubu img {
    flex: 1;
    min-height: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 70%;
    display: block;
  }
  .ubu figcaption {
    font-size: 13px;
    color: var(--sand-dim);
    padding: 12px 4px 4px;
  }
  .services > div {
    padding: 32px 30px;
    background: var(--graphite);
    border: 1px solid var(--line);
  }
  .services h3 {
    margin: 14px 0 12px;
  }
  .services p:last-child {
    color: var(--sand);
    margin: 0;
  }
  .credits {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--line);
  }
  .credits li {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    padding: 26px 0;
    border-bottom: 1px solid var(--line);
    flex-wrap: wrap;
  }
  .credits span {
    font-family: var(--serif);
    font-size: clamp(24px, 2.6vw, 32px);
  }
  .credits em {
    font-style: normal;
    color: var(--sand);
    align-self: center;
  }
  .credits .dev span {
    color: var(--sand);
  }
  .credits .tag {
    display: inline-block;
    margin-left: 12px;
    padding: 3px 9px;
    border: 1px solid rgba(207, 155, 92, 0.45);
    color: var(--gold);
    font-weight: 400;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    vertical-align: middle;
  }
  .fine {
    font-size: 13px;
    color: var(--sand-dim);
    margin-top: 24px;
  }

  .statement {
    position: relative;
    overflow: hidden;
    border-top: 0;
  }
  .statement .wrap {
    position: relative;
    z-index: 2;
  }
  .statement p {
    font-family: var(--serif);
    font-size: clamp(40px, 6.4vw, 84px);
    line-height: 1.1;
    margin: 0;
    text-align: center;
  }

  .essays {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
